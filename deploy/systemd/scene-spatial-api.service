[Unit]
Description=Scene Spatial PoC API
After=network.target

[Service]
Type=simple
User=ai3d
WorkingDirectory=/home/ai3d/src/scene-spatial-poc
EnvironmentFile=/home/ai3d/src/scene-spatial-poc/.env
ExecStart=/bin/bash /home/ai3d/src/scene-spatial-poc/scripts/start_api.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
