{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-spatial.local/schemas/sam_response.schema.json",
  "title": "SamResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "model", "detectionsPath", "maskDir", "durationMs", "peakGpuMemoryMiB"],
  "properties": {
    "status": {
      "enum": ["completed", "failed"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "detectionsPath": {
      "type": "string"
    },
    "maskDir": {
      "type": "string"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "peakGpuMemoryMiB": {
      "type": "integer",
      "minimum": 0
    },
    "error": {
      "type": "string"
    }
  }
}
