{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-spatial.local/schemas/spatial_scene_observation.schema.json",
  "title": "SpatialSceneObservation",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "taskId", "objects", "artifacts"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "anchor", "dimensions", "rotation", "confidence"],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "anchor": {
            "type": "object"
          },
          "dimensions": {
            "type": "object"
          },
          "rotation": {
            "type": "object"
          },
          "confidence": {
            "type": "object"
          }
        }
      }
    },
    "artifacts": {
      "type": "object"
    }
  }
}
